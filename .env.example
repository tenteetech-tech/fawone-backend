# Copiez ce fichier en .env puis adaptez les valeurs.

PORT=4000
HOST=127.0.0.1
# URL publique du frontend (liens d'invitation / réinitialisation)
APP_URL=http://localhost:3000
# Base SQLite (chemin relatif au dossier backend)
DATABASE_PATH=data/fawone.db

# Première super administratrice, créée au démarrage si aucune n'existe encore.
# (Alternative : npm run create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_BRANCH=Bureau exécutif


# --- Paiements : uniquement MTN Mobile Money et Orange Money via Campay (https://www.campay.net) ---
# demo = environnement de test (demo.campay.net) · live = production (www.campay.net)
CAMPAY_ENV=demo
# Identifiants de l'application Campay (onglet « Applications » > « API Keys » de votre compte)
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Facultatif : jeton d'accès permanent (remplace usuel/mot de passe)
CAMPAY_PERMANENT_TOKEN=
# Minutes avant d'abandonner un paiement non validé sur le téléphone
CAMPAY_PENDING_TIMEOUT_MINUTES=30
# Montants autorisés par don (FCFA). Par défaut : 5 à 25 en démo (limite imposée par Campay), 100 à 50 000 000 en live.
# CAMPAY_MIN_AMOUNT=
# CAMPAY_MAX_AMOUNT=

# Si le frontend appelle l'API directement (sans le proxy Next.js), lister ses origines :
# CORS_ORIGINS=https://app.fawone.org
# COOKIE_SECURE=true          # automatique en production (NODE_ENV=production)
# SESSION_DAYS=30
# LOG_REQUESTS=true

# Devise (franc CFA)
CURRENCY=XAF

# --- Notifications WhatsApp vers le groupe de l'association ---
# Envoyées automatiquement : nouveau projet, nouvel événement, actualité publiée, don confirmé.
# Fournisseur : none (désactivé) | console (affiche dans le terminal) | greenapi | whapi
WHATSAPP_PROVIDER=none
# Identifiant du groupe (se termine par @g.us). Pour le trouver : npm run whatsapp:groups
WHATSAPP_GROUP_ID=
# Événements à annoncer (liste séparée par des virgules)
WHATSAPP_EVENTS=project,event,news,donation
# Afficher le prénom des donatrices dans le groupe (false = anonyme)
WHATSAPP_SHOW_DONOR_NAMES=false
# Green-API (https://green-api.com) — idInstance et apiTokenInstance de la console
GREENAPI_API_URL=https://7107.api.greenapi.com
GREENAPI_ID_INSTANCE=710722776105
GREENAPI_API_TOKEN=
# Whapi.Cloud (https://whapi.cloud) — clé API copiée depuis la page du canal (pas d'Instance ID)
WHAPI_TOKEN=
# URL par défaut : https://gate.whapi.cloud (à modifier uniquement si Whapi vous en fournit une autre)
# WHAPI_API_URL=https://gate.whapi.cloud
